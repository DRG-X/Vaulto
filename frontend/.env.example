# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API.
#
# Both of these are NEXT_PUBLIC_, which means they are compiled into the
# JavaScript every visitor downloads. That is correct and expected for these
# two: the anon key is designed to be public, and Row Level Security is what
# decides what it can reach. The service_role key is NOT one of these — it
# belongs only in the backend's environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── API ───────────────────────────────────────────────────────────────────────
# The public URL of the deployed backend — no trailing slash. In production it
# must be https://, because an https:// page is not allowed to call http://.
#
# This is read at BUILD time, not at run time: Next.js compiles the value into
# the bundle. Setting it in Vercel after a deploy changes nothing until you
# redeploy. `next build` refuses to produce a production bundle without it,
# rather than shipping one that calls localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Admin ─────────────────────────────────────────────────────────────────────
# Supabase user UUIDs that see the admin links. Comma-separated.
# This only shows or hides UI — the enforcing list is ADMIN_USER_IDS on the
# backend, which is checked against the signed token.
NEXT_PUBLIC_ADMIN_USER_IDS=
