# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev default — no value needed):
# DATABASE_URL=sqlite:///./flint.db
# PostgreSQL (Railway / production):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Clerk Authentication ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
ADMIN_CLERK_IDS=clerk_user_id_1,clerk_user_id_2

# Clerk JWKS endpoint — required for JWT verification in auth.py
# Find your JWKS URL at: Clerk Dashboard → Configure → API Keys → Advanced → JWT public key URL
# Format: https://YOUR_CLERK_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# ── Upstash Redis Cache ────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production example: ALLOWED_ORIGINS=https://yourapp.vercel.app
# Add multiple origins: ALLOWED_ORIGINS=https://yourapp.vercel.app,https://yourapp-git-main.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Alert Notifications ────────────────────────────────────────────────────────
# Resend — email alerts. Free tier: 3,000 emails/month, 100/day.
# The 100/day cap is the one that bites: it limits how many alerts can fire.
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# The sender address. It MUST be on a domain verified in the Resend dashboard
# (Domains → Add Domain, then add the DKIM/SPF records). Until a domain is
# verified Resend rejects every send with HTTP 403.
#
# Leave unset to fall back to Resend's own onboarding@resend.dev, which works
# with no domain setup but ONLY delivers to the Resend account owner's address
# — enough to prove the pipeline works, not enough to serve users.
ALERT_FROM_EMAIL=Vaulto Alerts <alerts@yourdomain.com>

# NOTE: CLERK_SECRET_KEY above is also required for alerts. Clerk's default
# session token carries no email claim, so the recipient's address is read
# from Clerk's Backend API when it is not already stored locally.
