# ── Supabase Postgres ─────────────────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection string → URI.
#
# Use the TRANSACTION POOLER (port 6543) here. It is built for stateless apps
# like this one, and it is the connection that survives a serverless or
# autoscaled deployment opening many short-lived connections.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# The SESSION POOLER (port 5432), or the direct connection. Optional, and only
# used by Alembic: migrations run DDL in one transaction and need a single
# backend, which the transaction pooler cannot promise. Leave it unset and
# migrations run over DATABASE_URL, which is fine for a long-lived server.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# SQLite is still the local-dev default when DATABASE_URL is unset:
# DATABASE_URL=sqlite:///./flint.db

# Overrides the TLS mode for the Postgres connection. Supabase requires TLS, so
# the default is `require`; set `disable` only for a plaintext local Postgres.
# PGSSLMODE=require

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API. No trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard → Project Settings → API → service_role. SERVER-SIDE ONLY: this key
# bypasses Row Level Security entirely. Never expose it to a browser.
# Used to read a user's email out of auth.users when a rate alert fires and the
# local row has no address on file.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Only needed while the project still signs tokens with the LEGACY shared
# secret (Dashboard → Project Settings → API → JWT Settings → JWT Secret).
# Projects using asymmetric JWT signing keys do not need it: those tokens are
# verified against the project's JWKS, discovered from SUPABASE_URL.
SUPABASE_JWT_SECRET=

# Override JWKS discovery. Defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=

# Supabase user UUIDs allowed to reach /api/admin/*. Comma-separated.
# Find one under Dashboard → Authentication → Users.
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000

# ── Redis cache (OPTIONAL) ─────────────────────────────────────────────────────
# One variable, and it must be the REDIS-PROTOCOL url — `redis://` or `rediss://`
# for TLS. Upstash also publishes a REST endpoint and token; those are for a
# different client and are ignored here, which is why a deployment configured
# with them silently ran with no cache at all.
#
# Upstash: database page → Connect → "redis-cli" or "ioredis" tab → copy the
# rediss://default:PASSWORD@HOST:6379 string. Use the read-WRITE token; a
# read-only one (its username ends in `_ro`) makes every cache write fail.
#
# Leave unset and the app runs without caching — correct, just slower, and every
# comparison re-quotes all 28 providers.
# REDIS_URL=rediss://default:PASSWORD@your-endpoint.upstash.io:6379

# How long a cached comparison stays fresh. Default 300 (5 minutes).
# RATE_CACHE_TTL_SECONDS=300

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API. Scheme +
# host + port only — no trailing path, no trailing slash.
# Production example: ALLOWED_ORIGINS=https://vaulto.vercel.app
#
# Get this WRONG and the symptom is confusing: the API answers normally, the
# browser throws the response away, and the frontend reports a network error.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional regex for origins whose hostname is generated and so cannot be
# listed — Vercel preview deployments, whose URL carries the branch name.
# ALLOWED_ORIGIN_REGEX=https://vaulto-[a-z0-9-]+\.vercel\.app

# ── Rate-alert tick (REQUIRED, or alerts are never checked) ───────────────────
# The shared secret guarding POST /internal/check-alerts, which Supabase Cron
# calls every 15 minutes. There is no in-process scheduler any more: Cloud Run
# scales to zero, so a process that ticks between requests does not exist.
#
# Generate it yourself — nobody issues this:
#     openssl rand -hex 32
#
# The SAME value goes in two places:
#   1. here / the Cloud Run service (prefer Secret Manager over a plain env var)
#   2. Supabase Vault as `vaulto_cron_secret` — see supabase/cron_check_alerts.sql
#
# Unset, the endpoint answers 503 to everyone rather than running for anyone who
# asks. That is deliberate: it fails closed, and the 503 is how you find out.
CRON_SECRET=

# ── Alert Notifications ────────────────────────────────────────────────────────
# Resend — email alerts. Free tier: 3,000 emails/month, 100/day.
# The 100/day cap is the one that bites: it limits how many alerts can fire.
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# The sender address. It MUST be on a domain verified in the Resend dashboard
# (Domains → Add Domain, then add the DKIM/SPF records). Until a domain is
# verified Resend rejects every send with HTTP 403.
#
# Leave unset to fall back to Resend's own onboarding@resend.dev, which works
# with no domain setup but ONLY delivers to the Resend account owner's address
# — enough to prove the pipeline works, not enough to serve users.
ALERT_FROM_EMAIL=Vaulto Alerts <alerts@yourdomain.com>

# NOTE: SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above are also used by alerts,
# to recover an address for a user row that has none stored (every account
# carried over from Clerk, whose token had no email claim).

# ── Provider API keys (ALL OPTIONAL) ──────────────────────────────────────────
# 17 of the 28 providers are public and need nothing. The 11 below sit behind
# credentials you have to apply for; each one is simply reported as
# "not configured" in the comparison until its key is present, so the app is
# fully functional with this whole section left blank.
#
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# CURRENCYFAIR_API_KEY=
# INSTAREM_API_KEY=
# MONEYCORP_API_KEY=
# NIYO_API_KEY=
# NIYO_API_URL=            # this provider publishes no publicly documented URL
# OFX_API_KEY=
# REVOLUT_API_KEY=
# SINGX_API_KEY=
# TORFX_API_KEY=
# TORFX_API_URL=           # ditto
# WORLDREMIT_API_KEY=
# XE_ACCOUNT_ID=
# XE_API_KEY=
#
# Base-URL overrides, for when a partner agreement gives you a different
# endpoint than the documented one:
# CURRENCYFAIR_API_URL=  MONEYCORP_API_URL=  SINGX_API_URL=  WORLDREMIT_API_URL=

# ── Host-injected ─────────────────────────────────────────────────────────────
# PORT is set by Render / Railway / Fly automatically. Do not set it yourself.
